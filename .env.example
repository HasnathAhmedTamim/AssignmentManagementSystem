# Copy values into local files that are gitignored (e.g. frontend/.env.local,
# backend appsettings.Development.json). Do NOT put real production secrets here.
#
# For Docker Postgres defaults used in this repo, see docker-compose.yml and README.

# Backend (ASP.NET Core environment variables)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_management_db;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD

# JWT — use a long random secret in real deployments
Jwt__Key=YOUR_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
Jwt__Issuer=AssignmentManagementSystem
Jwt__Audience=AssignmentManagementUsers
Jwt__ExpiryInMinutes=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5249/api
